{
  "manifest_version": 3,
  "name": "Dynamics 365 & Dataverse DevLens",
  "short_name": "D365 DevLens",
  "version": "5.20.1",
  "version_name": "5.20.1 Metadata Intelligence Engine Phase 2",
  "description": "Developer diagnostics for Dynamics 365 and Dataverse with events, JavaScript, fields, metadata, process, custom control, security, audit, command palette, and developer toolkit capabilities.",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.dynamics.com/*"
  ],
  "action": {
    "default_title": "Dynamics 365 & Dataverse DevLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background-entry.js"
  },
  "commands": {
    "toggle-analyzer": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Minimize or restore DevLens (Alt+P)"
    },
    "command-palette": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open DevLens command palette (Alt+Shift+D)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dynamics.com/main.aspx*"
      ],
      "js": [
        "modules/source-indexer.js",
        "modules/impact-analyzer.js",
        "modules/call-graph-indexer.js",
        "modules/function-dependency-service.js",
        "ui/impact-view.js",
        "ui/function-dependency-view.js",
        "ui/metadata-view.js",
        "ui/process-view.js",
        "ui/custom-control-view.js",
        "ui/security-audit-view.js",
        "content-ui.js",
        "impersonation-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
